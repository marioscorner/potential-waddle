---
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout language="en" title="404 - Page not found" description="The requested page does not exist" noindex>
  <main class="flex min-h-screen flex-col items-center justify-center gap-4 bg-background px-6 text-center text-foreground">
    <h1 class="text-4xl font-bold">404</h1>
    <p class="text-muted-foreground">The requested page does not exist.</p>
    <a class="btn-primary" href="/es/">Go to the homepage</a>
  </main>
</SiteLayout>
