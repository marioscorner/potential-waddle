---
import {
  ArrowDownRight,
  ArrowUpRight,
  Award,
  Code2,
  Download,
  Globe2,
  Languages,
  MapPin,
  Moon,
  Send,
  Sun,
} from 'lucide-react';
import { FaGithub, FaInstagram, FaLinkedin } from 'react-icons/fa6';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { formatExperiencePeriod, sortExperiences } from '@/lib/experience';
import { getPortfolioData } from '@/lib/server/content';
import { translations, type Language } from '@/lib/translations';

type Props = { language: Language };
type LocalizedText = Partial<Record<Language, string>>;
type SocialLink = { name: string; url: string; icon: string };
type LanguageEntry = { name?: LocalizedText; level?: LocalizedText };
type Certification = { name?: LocalizedText; issuer?: LocalizedText };
type UploadAsset = { url?: string; updated_at?: string; created_at?: string; slot?: string };

const { language } = Astro.props;
const t = translations[language];
const { content, uploads } = await getPortfolioData();
const hero = content.hero?.[language] || t.hero;
const about = content.about?.[language] || t.about;
const status = content.status?.[language] || t.techStack;
const contact = content.contact?.[language] || t.contact;
const featured = content.featured?.[language] || t.featured;
const projects = content.projects?.[language] || t.projects;
const meta = content.meta?.[language] || t.meta;
const certifications: Certification[] = Array.isArray(content.certifications) ? content.certifications : [];
const languages: LanguageEntry[] = Array.isArray(content.languages) ? content.languages : [];
const experiences = Array.isArray(content.experience) ? sortExperiences(content.experience) : [];
const technologies: string[] = Array.isArray(content.technologies?.items) ? content.technologies.items : [];
const socialLinks: SocialLink[] = Array.isArray(content.social) ? content.social : [];
const sectionTitles = content.sectionTitles?.[language] || {};
const socialIcons = { FaLinkedin, FaGithub, FaInstagram, Globe2 };
const photoUpload = uploads.find((upload) => upload.slot === 'hero-photo');
const versionedUrl = (upload: UploadAsset | undefined, fallback: string) => {
  if (!upload?.url) return fallback;
  const cacheKey = upload.updated_at || upload.created_at;
  return `${upload.url}${cacheKey ? `?v=${encodeURIComponent(cacheKey)}` : ''}`;
};
const cvUrl = language === 'es' ? '/cv-es.pdf' : '/cv-en.pdf';
const heroPhotoUrl = versionedUrl(photoUpload, '/MY_PHOTO.webp');
const siteUrl = 'https://marioscorner.com';
const canonical = `${siteUrl}/${language}/`;
const safeExternalUrl = (value: unknown) => {
  try {
    const url = new URL(String(value));
    return ['http:', 'https:'].includes(url.protocol) ? url.href : '#';
  } catch {
    return '#';
  }
};
const personName = hero.name.replace(/\s*"marioscorner"\s*/i, ' ').replace(/\s+/g, ' ').trim();
const profileUrls = [...new Set([
  ...socialLinks.map((link) => safeExternalUrl(link.url)),
  safeExternalUrl(content.projects?.url),
].filter((url) => url !== '#'))];
const absoluteHeroPhotoUrl = new URL(heroPhotoUrl, siteUrl).href;
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'marioscorner',
      url: `${siteUrl}/`,
      inLanguage: ['es', 'en'],
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#profile`,
      url: canonical,
      name: meta.title,
      description: meta.description,
      inLanguage: language,
      isPartOf: { '@id': `${siteUrl}/#website` },
      mainEntity: {
        '@type': 'Person',
        '@id': `${siteUrl}/#person`,
        name: personName,
        alternateName: 'marioscorner',
        url: `${siteUrl}/`,
        image: absoluteHeroPhotoUrl,
        jobTitle: language === 'es' ? 'Desarrollador full stack' : 'Full stack developer',
        description: about.paragraph1,
        homeLocation: { '@type': 'Place', name: contact.location },
        sameAs: profileUrls,
      },
    },
  ],
}).replaceAll('<', '\\u003c');
const copy = language === 'es'
  ? { index: 'Índice', notes: 'Notas de perfil', current: 'Ahora', contact: 'Contacto', project: 'Proyecto' }
  : { index: 'Index', notes: 'Profile notes', current: 'Now', contact: 'Contact', project: 'Project' };
---

<SiteLayout language={language} title={meta.title} description={meta.description} schema={schema} image={absoluteHeroPhotoUrl}>
  <main id="main-content" class="portfolio-shell">
    <a class="skip-link" href="#profile-content">{language === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>

    <div class="portfolio-frame">
      <header class="portfolio-topbar">
        <a class="wordmark" href={`/${language}/`} aria-label="marioscorner home">marioscorner<span>.</span></a>
        <p class="topbar-location"><MapPin aria-hidden="true" /> {contact.location}</p>
        <div class="topbar-controls">
          <a
            href={language === 'es' ? '/en/' : '/es/'}
            class="utility-control language-control"
            aria-label={language === 'es' ? 'Switch to English' : 'Cambiar a Español'}
          >
            <Globe2 aria-hidden="true" />
            <span>{language === 'es' ? 'EN' : 'ES'}</span>
          </a>
          <button id="theme-toggle" class="utility-control" aria-label={language === 'es' ? 'Cambiar tema' : 'Toggle theme'} type="button">
            <Sun className="theme-sun" aria-hidden="true" />
            <Moon className="theme-moon hidden" aria-hidden="true" />
          </button>
        </div>
      </header>

      <div class="portfolio-grid" id="profile-content">
        <aside class="profile-rail" aria-label={copy.index}>
          <p class="eyebrow">{copy.index} / 01-05</p>
          <nav class="profile-nav">
            <a href="#about">01 <span>{about.title || t.about.title}</span></a>
            <a href="#experience">02 <span>{sectionTitles.experience || t.techStack.experience}</span></a>
            <a href="#project">03 <span>{copy.project}</span></a>
            <a href="#notes">04 <span>{copy.notes}</span></a>
            <a href="#contact">05 <span>{copy.contact}</span></a>
          </nav>
          <p class="rail-caption">{language === 'es' ? 'Madrid · disponible para construir lo que importa.' : 'Madrid · available to build what matters.'}</p>
        </aside>

        <div class="portfolio-content">
          <section class="hero-section reveal" aria-labelledby="profile-title">
            <div class="hero-copy">
              <p class="eyebrow"><span class="live-dot" style={`background-color: ${content.status?.indicatorColor || '#22c55e'}`}></span>{sectionTitles.hero || status.status || copy.current} / {status.available}</p>
              <h1 id="profile-title">{hero.greeting}<br /><strong>{personName}</strong><br /><span>{hero.intro}</span></h1>
              <p class="hero-intro">{hero.cta}</p>
              <p class="status-detail">{status.statusDetail}</p>
              <div class="hero-actions">
                <a href={`mailto:${contact.email}`} class="action-link action-link-primary"><Send aria-hidden="true" />{contact.sendEmail}<ArrowUpRight aria-hidden="true" /></a>
                <a href={cvUrl} download class="action-link"><Download aria-hidden="true" />{hero.downloadCV}</a>
              </div>
            </div>
            <figure class="hero-portrait">
              <div class="portrait-frame">
                <img src={heroPhotoUrl} alt={language === 'es' ? `Foto de ${personName}` : `Photo of ${personName}`} width="512" height="512" fetchpriority="high" decoding="async" />
              </div>
              <figcaption><span>01</span> {language === 'es' ? 'Perfil de desarrollador' : 'Developer profile'}</figcaption>
            </figure>
          </section>

          <section class="about-section reveal" id="about" aria-labelledby="about-title">
            <div class="section-marker"><span>01</span><h2 id="about-title">{about.title || t.about.title}</h2></div>
            <div class="about-copy">
              <p class="about-lead">{about.paragraph1}</p>
              <p>{about.paragraphFullStack}</p>
              <p>{about.paragraph2}</p>
            </div>
          </section>

          <section class="experience-section reveal" id="experience" aria-labelledby="experience-title">
            <div class="section-marker"><span>02</span><h2 id="experience-title">{sectionTitles.experience || t.techStack.experience}</h2></div>
            <div class="experience-list">
              {experiences.map((job) => (
                <article class="experience-entry">
                  <time datetime={job.startDate}>{formatExperiencePeriod(job, language)}</time>
                  <div>
                    <p class="experience-company">{job.company}</p>
                    <h3>{job.position?.[language]}</h3>
                    {job.responsibilities?.[language]?.length > 0 && (
                      <ul>
                        {job.responsibilities[language].map((responsibility) => <li>{responsibility}</li>)}
                      </ul>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="featured-section reveal" id="project" aria-labelledby="featured-project-title">
            <div class="featured-heading">
              <p class="eyebrow">03 / {featured.title}</p>
              <span class="project-stamp">{featured.comingSoon || t.featured.comingSoon}</span>
            </div>
            <div class="featured-body">
              <div>
                <h2 id="featured-project-title">{featured.projectTitle}</h2>
                <p>{featured.description}</p>
                <p>{featured.description2}</p>
              </div>
              <div class="featured-action">
                <p>{featured.cta}</p>
                <a href={safeExternalUrl(content.featured?.url)} target="_blank" rel="noopener noreferrer" class="action-link">{featured.visitWeb}<ArrowUpRight aria-hidden="true" /></a>
              </div>
            </div>
          </section>

          <section class="notes-section reveal" id="notes" aria-labelledby="notes-title">
            <div class="section-marker"><span>04</span><h2 id="notes-title">{copy.notes}</h2></div>
            <div class="notes-grid">
              <section class="note-block" aria-labelledby="technologies-title">
                <div class="note-title"><Code2 aria-hidden="true" /><h3 id="technologies-title">{sectionTitles.technologies || t.technologies.title}</h3></div>
                <div class="technology-list">{technologies.map((technology, index) => <span><b>{String(index + 1).padStart(2, '0')}</b>{technology}</span>)}</div>
              </section>
              <section class="note-block" aria-labelledby="languages-title">
                <div class="note-title"><Languages aria-hidden="true" /><h3 id="languages-title">{sectionTitles.languages || t.languages.title}</h3></div>
                <dl class="definition-list">{languages.map((item) => <div><dt>{item.name?.[language]}</dt><dd>{item.level?.[language]}</dd></div>)}</dl>
              </section>
              <section class="note-block" aria-labelledby="certifications-title">
                <div class="note-title"><Award aria-hidden="true" /><h3 id="certifications-title">{sectionTitles.certifications || t.certifications.title}</h3></div>
                <ul class="certification-list">{certifications.map((certification) => <li><strong>{certification.name?.[language]}</strong>{certification.issuer && <span>{certification.issuer[language]}</span>}</li>)}</ul>
              </section>
            </div>
          </section>

          <section class="contact-section reveal" id="contact" aria-labelledby="contact-title">
            <div class="contact-heading">
              <p class="eyebrow">05 / {copy.contact}</p>
              <h2 id="contact-title">{contact.title}</h2>
            </div>
            <div class="contact-details">
              <a class="contact-email" href={`mailto:${contact.email}`}>{contact.email}<ArrowUpRight aria-hidden="true" /></a>
              <div class="social-list">
                {socialLinks.map((link) => {
                  const SocialIcon = socialIcons[link.icon as keyof typeof socialIcons] || Globe2;
                  return <a href={safeExternalUrl(link.url)} target="_blank" rel="noopener noreferrer"><SocialIcon aria-hidden="true" />{link.name}<ArrowUpRight aria-hidden="true" /></a>;
                })}
                <a href={safeExternalUrl(content.projects?.url)} target="_blank" rel="noopener noreferrer"><FaGithub aria-hidden="true" />{projects.visitGitHub}<ArrowUpRight aria-hidden="true" /></a>
              </div>
              <p class="projects-note"><strong>{projects.title}</strong>{projects.description}</p>
            </div>
          </section>
        </div>
      </div>

      <footer class="portfolio-footer">
        <p>© {new Date().getFullYear()} · {content.footer?.[language]?.madeWith || t.footer.madeWith} <span>♥</span> {content.footer?.[language]?.by || t.footer.by} {content.footer?.[language]?.name || t.footer.name}</p>
        <a href="#main-content">{language === 'es' ? 'Volver arriba' : 'Back to top'} <ArrowDownRight aria-hidden="true" /></a>
      </footer>
    </div>
  </main>

  <script>
    const button = document.querySelector('#theme-toggle');
    button?.addEventListener('click', () => {
      const isLight = document.documentElement.classList.toggle('light');
      document.documentElement.classList.toggle('dark', !isLight);
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
      document.querySelector('.theme-sun')?.classList.toggle('hidden', isLight);
      document.querySelector('.theme-moon')?.classList.toggle('hidden', !isLight);
    });
  </script>
</SiteLayout>
