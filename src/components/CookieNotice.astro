---
type Props = { language: 'es' | 'en' };

const { language } = Astro.props;
const copy = language === 'es'
  ? {
      dismiss: 'Entendido',
      details: 'Ver política de cookies',
      heading: 'Privacidad y cookies',
      hideDetails: 'Ocultar política de cookies',
      intro: 'Este sitio no utiliza cookies publicitarias ni de analítica.',
      storage: 'Solo guarda localmente tu preferencia de tema y que has cerrado este aviso.',
      session: 'El área de administración usa una cookie de sesión técnica únicamente después de iniciar sesión.',
    }
  : {
      dismiss: 'Got it',
      details: 'View cookie policy',
      heading: 'Privacy and cookies',
      hideDetails: 'Hide cookie policy',
      intro: 'This site does not use advertising or analytics cookies.',
      storage: 'It only stores your theme preference and that you have closed this notice locally.',
      session: 'The admin area uses a technical session cookie only after you sign in.',
    };
---

<aside
  data-cookie-notice
  hidden
  role="region"
  aria-labelledby="cookie-notice-title"
  class="fixed inset-x-4 bottom-4 z-[60] mx-auto max-w-xl rounded-2xl border border-border bg-card p-4 shadow-2xl sm:inset-x-auto sm:right-6 sm:w-[32rem]"
>
  <div class="flex flex-col gap-3">
    <div class="space-y-1">
      <h2 id="cookie-notice-title" class="text-sm font-semibold text-foreground">{copy.heading}</h2>
      <p class="text-sm leading-relaxed text-muted-foreground">{copy.intro} {copy.storage}</p>
    </div>
    <div data-cookie-details hidden class="border-l-2 border-primary pl-3 text-sm leading-relaxed text-muted-foreground">
      <p>{copy.session}</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button
        data-cookie-details-toggle
        data-show-label={copy.details}
        data-hide-label={copy.hideDetails}
        type="button"
        aria-expanded="false"
        class="text-sm font-medium text-primary underline-offset-4 hover:underline"
      >
        {copy.details}
      </button>
      <button data-cookie-dismiss type="button" class="btn-accent ml-auto px-4 py-2 text-sm">
        {copy.dismiss}
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  const notice = document.querySelector('[data-cookie-notice]');
  const storageKey = 'cookie-notice-dismissed';

  if (notice && !localStorage.getItem(storageKey)) {
    notice.hidden = false;
    const details = notice.querySelector('[data-cookie-details]');
    const toggle = notice.querySelector('[data-cookie-details-toggle]');
    const dismiss = notice.querySelector('[data-cookie-dismiss]');

    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.textContent = isOpen ? toggle.dataset.showLabel : toggle.dataset.hideLabel;
      details.hidden = isOpen;
    });

    dismiss?.addEventListener('click', () => {
      localStorage.setItem(storageKey, 'true');
      notice.hidden = true;
    });
  }
</script>
