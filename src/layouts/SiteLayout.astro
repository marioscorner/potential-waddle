---
import '../index.css';
import CookieNotice from '@/components/CookieNotice.astro';

type Props = {
  language: 'es' | 'en';
  title: string;
  description: string;
  schema?: string;
  noindex?: boolean;
  image?: string;
};

const { language, title, description, schema, noindex = false, image: suppliedImage } = Astro.props;
const siteUrl = 'https://marioscorner.com';
const canonical = `${siteUrl}/${language}/`;
const image = suppliedImage || `${siteUrl}/MY_PHOTO.png`;
---

<!doctype html>
<html lang={language} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="marioscorner" />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="es" href={`${siteUrl}/es/`} />}
    {!noindex && <link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={`${siteUrl}/es/`} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {!noindex && <meta property="og:type" content="profile" />}
    {!noindex && <meta property="og:title" content={title} />}
    {!noindex && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    {!noindex && <meta property="og:image" content={image} />}
    {!noindex && <meta property="og:image:alt" content={title} />}
    {!noindex && <meta property="og:locale" content={language === 'es' ? 'es_ES' : 'en_US'} />}
    {!noindex && <meta property="og:site_name" content="marioscorner" />}
    {!noindex && <meta name="twitter:card" content="summary_large_image" />}
    {!noindex && <meta name="twitter:title" content={title} />}
    {!noindex && <meta name="twitter:description" content={description} />}
    {!noindex && <meta name="twitter:image" content={image} />}
    {!noindex && <meta name="twitter:image:alt" content={title} />}
    {schema && <script is:inline type="application/ld+json" set:html={schema} />}
    {!noindex && <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      document.documentElement.classList.toggle('light', savedTheme === 'light');
      document.documentElement.classList.toggle('dark', savedTheme !== 'light');
    </script>}
  </head>
  <body style={noindex ? 'background-color: #0d0d0f;' : undefined}>
    <slot />
    {!noindex && <CookieNotice language={language} />}
  </body>
</html>
