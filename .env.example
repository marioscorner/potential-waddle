# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
# For production: use strong password and proper PostgreSQL host
DB_PASSWORD=your_secure_password_here_change_in_production
DATABASE_URL=postgres://portfolio:your_secure_password_here_change_in_production@postgres:5432/portfolio

# Admin Configuration
ADMIN_USER=admin
# Option A: simplest Docker setup. The server hashes this in memory at startup.
ADMIN_PASSWORD=your_admin_password_here_change_in_production
# Option B: preferred if you do not want plaintext in .env. Generate with: pnpm hash-password
ADMIN_PASSWORD_HASH='your_hashed_password_here'
SESSION_SECRET=your_random_secret_here_change_in_production

# File Upload Configuration
UPLOAD_DIR=./uploads
